# Nach .env kopieren und anpassen. Ohne .env läuft alles auf einem Rechner.

# --- Verteilter Betrieb -----------------------------------------------------
# Auf ALLEN beteiligten Rechnern identisch setzen: Adresse des Rechners, auf dem
# der jeweilige Broker läuft (IP oder DNS-Name, von allen anderen erreichbar).
# Freizugebende Ports je Broker n: n9092 (Clients, Inter-Broker), n9093 (Controller).
#BROKER1_HOST=192.168.10.11
#BROKER2_HOST=192.168.10.12
#BROKER3_HOST=192.168.10.13

# Muss auf allen Rechnern gleich sein; nur ändern, um einen neuen Cluster anzulegen.
#KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
#KAFKA_IMAGE=apache/kafka:4.3.1

# --- SASL und TLS -----------------------------------------------------------
# Die beiden COMPOSE_-Zeilen schalten den ganzen Test auf SASL_SSL um (Broker-Listener
# n9095, alle drei Clients). Auf allen beteiligten Rechnern gleich setzen.
# .env steht in .gitignore: das Passwort gehört nur hierher, nicht in diese Vorlage.
#COMPOSE_FILE=docker-compose.yaml,docker-compose.secure.yaml
#COMPOSE_PATH_SEPARATOR=,
#KLT_SASL_USERNAME=loadtest
#KLT_SASL_PASSWORD=
# SCRAM-SHA-512 (Default) oder PLAIN
#KLT_SASL_MECHANISM=SCRAM-SHA-512

# --- Lasttest-Clients -------------------------------------------------------
# Scenario aus ./scenarios für alle Clients bzw. je Variante
#KLT_SCENARIO=01-baseline.yaml
#KLT_PYTHON_SCENARIO=07-producer-only.yaml
#KLT_SPRING_SCENARIO=06-consumer-only.yaml
#KLT_QUARKUS_SCENARIO=03-slow-consumer-poll-timeout.yaml

# Standard: jede Variante hat ihr eigenes Topic und ihre eigene Gruppe.
# Gleiches Topic setzen, damit z. B. Python sendet und Spring empfängt.
#KLT_PYTHON_TOPIC=loadtest
#KLT_SPRING_TOPIC=loadtest
#KLT_QUARKUS_TOPIC=loadtest
#KLT_SPRING_GROUP_ID=klt-spring

# 0 = unbegrenzt (Daemon). Mit Wert beendet sich der Lauf und der Container startet neu.
#KLT_DURATION=0
#KLT_COUNT=0
#KLT_REPORT_INTERVAL=10

# Externer Cluster statt der Broker aus diesem Compose
#KLT_BOOTSTRAP_SERVERS=kafka.example.com:9094

# Images aus einer Registry statt lokal gebaut
#KLT_SPRING_IMAGE=registry.example.com/kafka-loadtest-spring:latest
#KLT_QUARKUS_IMAGE=registry.example.com/kafka-loadtest-quarkus:latest
#KLT_PYTHON_IMAGE=registry.example.com/kafka-loadtest-python:latest

# --- Broker-Stellschrauben --------------------------------------------------
#KAFKA_CONNECTIONS_MAX_IDLE_MS=600000
#KAFKA_GROUP_MIN_SESSION_TIMEOUT_MS=6000
#KAFKA_GROUP_MAX_SESSION_TIMEOUT_MS=1800000
